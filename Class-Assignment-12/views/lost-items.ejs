<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lost items · CampusFind</title><link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header"><a class="brand" href="/">Campus<span>Find</span></a><nav><a class="active" href="/lost-items">Lost items</a><a href="/found-items">Found items</a><a href="/students">Students</a><a href="/#report-lost">Report item</a></nav></header>
  <main class="container page-content">
    <p class="eyebrow">Help someone find it</p><h1>Lost item reports</h1>
    <form class="search-form" method="GET" action="/lost-items"><input name="search" value="<%= search %>" placeholder="Search name, category or location" aria-label="Search lost items"><button class="button" type="submit">Search</button><% if (search) { %><a class="text-link" href="/lost-items">Clear</a><% } %></form>
    <% if (lostItems.length === 0) { %><div class="empty-state"><h2><%= search ? 'No matching reports' : 'No lost items reported yet' %></h2><p><%= search ? 'Try another search term.' : 'Lost reports will appear here once students post them.' %></p><a class="button" href="/#report-lost">Report a lost item</a></div><% } else { %>
      <div class="card-grid"><% lostItems.forEach((item) => { %>
        <article class="panel item-card"><span class="badge badge-lost">Lost</span><p class="eyebrow"><%= item.category %></p><h2><a href="/lost-items/<%= item._id %>"><%= item.itemName %></a></h2><p><%= item.lastSeenLocation %></p><p class="muted">Lost <%= item.dateLost.toLocaleDateString() %> · Reported by <%= item.reportedBy.fullName %></p><a class="text-link" href="/lost-items/<%= item._id %>">View report →</a></article>
      <% }) %></div>
    <% } %>
  </main>
</body>
</html>
